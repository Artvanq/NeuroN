# =============================================================================
# Neuron — единый шаблон окружения (корень репозитория)
#
#   cp .env.example .env
#
# Используют:
#   - API + workers (neuron_backend/neuron_backend)
#   - Next.js (neuron_frontend) — NEXT_PUBLIC_* нужен rebuild после смены
#   - docker compose -f docker-compose.prod.yml
#
# Coolify: те же ключи в UI; см. docs/COOLIFY.md
# =============================================================================

# ─── URLs (без слэша в конце) ───
FRONTEND_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── API ───
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://neuron:neuron@127.0.0.1:5433/neuron
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth (обязательно в production) ───
JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS
CHAT_ENCRYPTION_KEY=CHANGE_ME_MIN_32_RANDOM_CHARS
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_TTL_SEC=2592000
JWT_SECRET_ROTATION_DAYS=90

# ─── Email (Resend) ───
RESEND_API_KEY=
RESEND_FROM=Neuron <noreply@yourdomain.com>
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_TTL_MIN=1440
PASSWORD_RESET_TTL_MIN=60

# ─── Media (v1: disabled) ───
MEDIA_STORAGE=disabled
# MEDIA_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=neuron-media
# R2_PUBLIC_URL=
# MEDIA_SCAN_URL=
# MEDIA_SCAN_TOKEN=

# ─── Invites & communities ───
INVITE_REQUIRED=false
FOUNDER_INVITE_CODES=NEURON-FOUNDERS,NEURON-MINDS
SEED_DEMO=true
MODERATOR_USERNAMES=yourusername
SITE_OWNER_USERNAME=yourusername
ALLOW_USER_COMMUNITIES=true
FEATURE_FLAGS=

# ─── Captcha (optional) ───
CAPTCHA_SECRET=
REPORT_CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ─── OAuth (optional) ───
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Moderation ───
REPORT_ABUSE_BLOCK_THRESHOLD=12
REPORT_ABUSE_DECAY_HOURS=24
MOD_EXPORT_RATE_MAX=6
MOD_EXPORT_RATE_WINDOW_SEC=900
BAN_APPEAL_WINDOW_DAYS=7
BAN_APPEAL_MAX_PER_WINDOW=3

# ─── Workers ───
ANALYTICS_POLL_MS=5000
ANALYTICS_BATCH_SIZE=50
DIGEST_POLL_MS=3600000
DIGEST_HOURS=24
# CLICKHOUSE_URL=
# CLICKHOUSE_TABLE=analytics_events

# ─── Web Push (optional) ───
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@yourdomain.com

# ─── Sentry (optional) ───
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Legal (frontend build + runtime) ───
# NEXT_PUBLIC_LEGAL_OPERATOR=Your Organization
# NEXT_PUBLIC_LEGAL_CONTACT=legal@yourdomain.com

# ─── Docker Compose (dev + prod): пароли только в .env, не в compose-файлах ───
POSTGRES_USER=neuron
# Локально можно neuron; в production — сильный пароль (файл .env в gitignore)
POSTGRES_PASSWORD=neuron
POSTGRES_DB=neuron
API_PORT=4000
WEB_PORT=3001

# ─── Git SSH (optional) ───
# SSH_GIT_PORT=2222
# SSH_GIT_HOST=git.yourdomain.com
